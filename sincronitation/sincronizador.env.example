# ==========================================================================
# Variables que usa sincronitation/sincronizador.py en tu PC (Windows)
# ==========================================================================
# IMPORTANTE:
#   - El sincronizador lee estas variables desde la RAÍZ del proyecto:
#       ./.env  (texto plano, solo desarrollo)   o   ./.env.enc (bóveda cifrada, recomendado)
#   - NO crees sincronitation/.env: no se lee y además está ignorado por Git.
#   - Este archivo es solo una plantilla SIN secretos reales.
#   - Cifra tu .env con:  node scripts/local-vault.js encrypt
# ==========================================================================

# --- Descubrimiento del servidor (uno de los dos mecanismos) ---
# a) Automático vía GitHub Actions Variables (PAT fine-grained de SOLO lectura de variables)
GITHUB_REPO=tu-usuario/tu-repositorio
GITHUB_TOKEN=github_pat_xxx_solo_lectura_variables
# b) Manual (cualquiera de estos alias)
EC2_HOST=tu_ip_o_dominio_servidor
# AWS_HOST=tu_ip_o_dominio_servidor
# URL_AWS=https://tu_dominio
# PORT=3000

# --- Documentos Word locales ---
WORD_FILE_PATH=C:\ruta\a\tu\Diario.docx
ENGLISH_WORD_FILE_PATH=C:\ruta\a\tu\English_Learning_Notebook.docx
WORD_PASSWORD=contrasena_de_proteccion_del_word

# --- E2EE (debe coincidir EXACTAMENTE con el servidor; 32 bytes) ---
JOURNAL_SECRET_KEY=clave_e2ee_de_32_caracteres______

# --- Opcionales ---
# ADMIN_SECRET=solo_si_usas_el_puente_pc_firmado_hmac
# YT_DLP_PATH=C:\ruta\a\yt-dlp.exe
# YT_DLP_COOKIES_PATH=C:\ruta\a\cookies.txt
# MOOD_DPAPI_VAULT_PATH=C:\ruta\personalizada\vault.dpapi
# MOOD_ENV_PASS=   (NO la guardes aquí; úsala solo como variable temporal de sesión)
