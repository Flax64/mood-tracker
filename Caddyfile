{
    auto_https disable_redirects
    servers {
        trusted_proxies static private_ranges
    }
}

(app_upstream_pool) {
    header -Server
    request_body {
        max_size 16MB
    }
    encode zstd gzip
    reverse_proxy app:{$PORT:3000} app2:{$PORT:3000} {
        lb_policy cookie pdh_lb
        lb_try_duration 3s
        lb_try_interval 250ms
        health_uri /healthz
        health_interval 15s
        health_timeout 5s
        health_status 200
        fail_duration 30s
        max_fails 3
    }
}

{$SITE_ADDRESS::80} {
    import app_upstream_pool
}

:443 {
    tls internal
    import app_upstream_pool
}
