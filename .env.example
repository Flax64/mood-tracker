# ==========================================
# Base de Datos y Servidor (Node.js / Docker)
# ==========================================
DB_HOST=db
DB_USER=root
DB_PASS=cambia_esta_contrasena
DB_NAME=MoodTrackerLocal
PORT=3000
TZ=America/Monterrey
# UID/GID del usuario propietario en Ubuntu (consulta con `id -u` / `id -g`; por defecto 1000)
APP_UID=1000
APP_GID=1000

# ==========================================
# Autenticación, Seguridad y Correo (Gmail SMTP)
# ==========================================
# Correo con rol de Propietario (Admin) que recibe los códigos de autorización
ADMIN_EMAIL=tu_correo_admin@ejemplo.com
# Palabra/clave secreta personal para validar tu primer registro
ADMIN_SECRET=tu_respuesta_o_clave_secreta_personal
# Cuenta Gmail que ENVÍA los correos (puede ser la misma u otra dedicada)
SMTP_USER=tu_correo_envio@gmail.com
# Contraseña de aplicación de 16 letras de la cuenta configurada en SMTP_USER
SMTP_PASS=tu_contrasena_de_aplicacion_gmail_16_letras
# URL pública base (con Tailscale Serve usa https://<tu-maquina>.<tu-tailnet>.ts.net)
APP_BASE_URL=https://tu-servidor.tu-tailnet.ts.net
# Confía en proxy inverso (1 para Tailscale Serve o Caddy directo; 2 si encadenas Tailscale Serve -> Caddy en PROXY_HTTP_PORT)
TRUST_PROXY=1
# Exige HTTPS en producción (con Tailscale Serve activado usa true; en dev local HTTP usa false)
REQUIRE_HTTPS=true
# Exige firma HMAC en rutas puente legadas (/api/pull-text y /api/pull-english)
REQUIRE_PC_BRIDGE_AUTH=true
# Orígenes adicionales permitidos en CORS (opcional, separados por coma; *.ts.net y APP_BASE_URL ya se permiten)
CORS_ALLOWED_ORIGINS=
# Dirección y punto de entrada del balanceador Caddy (enlazado a loopback: `sudo tailscale serve --bg http://127.0.0.1:8080`)
SITE_ADDRESS=:80
PROXY_HTTP_PORT=8080
PROXY_HTTPS_PORT=8443

# ==========================================
# Arquitectura Dual Drive (rclone) + Notas Autónomas en Servidor Ubuntu
# ==========================================
# Activa escritura autónoma en el servidor (English -> volumen local ./english-notes + Drive opcional, Journal -> local cifrado con contraseña)
SERVER_AUTONOMOUS_NOTES=true
# Google Drive (rclone) es 100% OPCIONAL: si no configuras rclone, todo funciona local en ~/projects/respaldos y ./english-notes
# Drive 1 (Clínico / BD): respaldos y retención en MySQL (0 = conservar TODO ilimitado en disco >= 300 GB)
RCLONE_REMOTE=gdrive
RCLONE_BACKUP_DIR=RespaldosApp
DB_RETENTION_DAYS=0
# Copias rotativas locales (aprovechando almacenamiento >= 300 GB): SQL diario 180 días (mensual permanente) y Word diario 365 días
LOCAL_SQL_DAILY_BACKUP_DAYS=180
LOCAL_WORD_BACKUP_DAYS=365
# Drive 2 (Estudio Idiomas, opcional): si STUDY_RCLONE_REMOTE está vacío usa ./english-notes/English_Learning_Notebook.docx 100% local
STUDY_RCLONE_REMOTE=
STUDY_RCLONE_DIR=NotasIdiomas
# Rutas dentro del contenedor Docker (mapeadas a ./data/journal y ./english-notes en docker-compose.yml)
JOURNAL_LOCAL_PATH=/app/journal-data/Diario.docx
ENGLISH_WORD_FILE_PATH=/app/english-notes/English_Learning_Notebook.docx

# ==========================================
# Seguridad E2EE y Cifrado Local del Journal
# ==========================================
WORD_PASSWORD=tu_contrasena_de_word
JOURNAL_SECRET_KEY=tu_clave_e2ee_de_32_caracteres____

# ==========================================
# Cliente Local de Sincronización a Word (Legado opcional en Windows)
# ==========================================
GITHUB_REPO=tu-usuario/tu-repositorio
GITHUB_TOKEN=tu_fine_grained_pat_solo_lectura_variables
EC2_HOST=tu_ip_o_dominio_servidor
AWS_HOST=tu_ip_o_dominio_servidor
# WORD_FILE_PATH=C:\ruta\a\tu\Diario.docx

# ==========================================
# IA para Estudio Activo de Idiomas (Gemini API)
# ==========================================
# Clave de Google AI Studio (Gemini API). Los modelos disponibles se consultan dinámicamente.
GEMINI_API_KEY=tu_api_key_de_google_ai_studio

# ==========================================
# Extractor yt-dlp en Servidor / Local (Opcional)
# ==========================================
# En Docker Linux se usa /usr/local/bin/yt-dlp automáticamente.
# Ruta opcional a cookies Netscape dentro del volumen ./data/ytdlp si YouTube exige sesión
# YTDLP_COOKIES_PATH=/app/ytdlp-config/cookies.txt

# ==========================================
# Logs Persistentes y Rotativos del Servidor
# ==========================================
LOG_DIR=/app/logs
LOG_LEVEL=info
LOG_MAX_BYTES=20971520
LOG_MAX_FILES=10
