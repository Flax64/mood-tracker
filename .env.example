# ==========================================
# Base de Datos y Servidor (Node.js / Docker)
# ==========================================
DB_HOST=db
DB_USER=root
DB_PASS=cambia_esta_contrasena
DB_NAME=MoodTrackerLocal
PORT=3000
TZ=America/Monterrey

# ==========================================
# Respaldos en Google Drive (rclone)
# ==========================================
RCLONE_REMOTE=gdrive
RCLONE_BACKUP_DIR=RespaldosApp

# ==========================================
# Sincronizador local de Journal a Word (Windows)
# ==========================================
# Opción recomendada: leer EC2_HOST automáticamente desde GitHub Actions Variables
GITHUB_REPO=Flax64/mood-tracker
GITHUB_TOKEN=tu_fine_grained_pat_solo_lectura_variables

# Respaldo opcional (solo se usa si no configuras GITHUB_TOKEN)
AWS_HOST=tu_ip_publica_aws
WORD_FILE_PATH=C:\ruta\a\tu\documento.docx
WORD_PASSWORD=tu_contrasena_de_word
JOURNAL_SECRET_KEY=tu_clave_e2ee_de_32_caracteres____
